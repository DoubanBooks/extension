{
  "name": "bookfish-extension",
  "version": "1.1.0",
  "description": "BookFish - Chrome extension for comparing used book prices on Douban",
  "scripts": {
    "release": "standard-version",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "pack:chrome": "zip -r -X ../bookfish-chrome.zip . -x \"*.git*\" -x \"node_modules/*\" -x \"*.DS_Store\" -x \"scripts/*\" -x \"*.py\"",
    "pack:firefox": "web-ext build --source-dir=./ --artifacts-dir=../dist-firefox --overwrite-dest",
    "lint:firefox": "web-ext lint --source-dir=./"
  },
  "devDependencies": {
    "standard-version": "^9.5.0",
    "web-ext": "^7.12.0"
  },
  "standard-version": {
    "bumpFiles": [
      "package.json",
      "manifest.json"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:DoubanBooks/extension.git"
  }
}
